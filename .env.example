NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Owner WhatsApp for pending signup support (shown on /pending)
NEXT_PUBLIC_SUPPORT_WHATSAPP=+91XXXXXXXXXX
# Demo only: auto-approve salons after onboarding (default off in production).
# Requires SUPABASE_SERVICE_ROLE_KEY on the server when enabled.
NEXT_PUBLIC_DEMO_AUTOAPPROVE=false
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
